// Firestore security rules for Oscar Gym.
// Paste into Firebase console → Build → Firestore Database → Rules → Publish.
//
// Each signed-in person can read and write ONLY their own folder:
//   users/{their uid}/exercises/{id}
//   users/{their uid}/sets/{id}
// Nobody can read anyone else's, and signed-out requests are refused entirely.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
